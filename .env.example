# Demonstração é o padrão. Para o piloto, configurar as chaves públicas de HOMOLOGAÇÃO.
VITE_PCIF_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Somente runtime das Netlify Functions (não usar prefixo VITE_).
PCIF_PILOT_ENABLED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PCIF_OPERATOR_EMAIL_DOMAIN=pcif-operators.invalid

# Somente Functions runtime: chave secret/service_role de HOMOLOGAÇÃO. Nunca usar VITE_.
# Necessária apenas para liberar a troca inicial após reautenticação; não inserir valor neste arquivo.
PCIF_PASSWORD_ADMIN_KEY=
